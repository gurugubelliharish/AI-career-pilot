# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=aicareer
POSTGRES_USER=aicareer
POSTGRES_PASSWORD=aicareer

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=aicareer

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong 256-bit secret: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-256-bit-key

# ─── Ollama ───────────────────────────────────────────────────────────────────
# OLLAMA_URL=http://ollama:11434   # auto-set in docker-compose
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=AIJobRadarBot

# ─── Email ───────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost
